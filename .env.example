# ---------------------------------------------------------------------------
# Solana AI Wallet — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit .env.local
# ---------------------------------------------------------------------------

# --- AI provider (SERVER-SIDE ONLY) ----------------------------------------
# Supply ONE of the following. The key is read only inside /api/interpret and is
# never sent to the browser. Do NOT prefix either of these with NEXT_PUBLIC_.
#
# If neither key is set, the app falls back to a deterministic local parser.
# The UI then labels the interpretation engine as "local parser" so it is always
# obvious to the user (and to a judge) that no language model was involved.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Using a different OpenAI-compatible provider ---------------------------
# OPENAI_API_KEY is sent to this endpoint instead of OpenAI's. Any host that
# speaks the OpenAI chat-completions protocol works. Leave blank for OpenAI.
#
# OpenRouter, which has free models and needs no card:
#   1. Sign up at https://openrouter.ai and create a key under Keys
#   2. OPENAI_API_KEY=sk-or-v1-...
#   3. OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   4. OPENAI_MODEL=<a model ending in :free> — check
#      https://openrouter.ai/models?max_price=0 for what is free today
#
# Strict json_schema output is an OpenAI feature; other providers get plain
# JSON mode with the shape described in the prompt. The reply is validated by
# Zod either way, so a model that returns the wrong shape is rejected and the
# built-in parser answers instead.
OPENAI_BASE_URL=

# --- Solana RPC (public, safe to expose) -----------------------------------
# Devnet only. Leave blank to use the public endpoint https://api.devnet.solana.com
# A dedicated RPC (Helius / QuickNode devnet URL) is more reliable for a live demo.
NEXT_PUBLIC_SOLANA_RPC_URL=
